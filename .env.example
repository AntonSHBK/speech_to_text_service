# Интерфейс управления
USE_INTERFACE=False

# Параметры CPU и параллельной обработки модели транскрибации
MODEL_CPU_THREADS=0
MODEL_NUM_CPU_WORKERS=1

# Локальное использование моделей без запросов к Hugging Face
MODEL_LOCAL_FILES_ONLY=True
DIARIZATION_LOCAL_FILES_ONLY=True

# Тип вычислений faster-whisper для разных размеров моделей
MODEL_COMPUTE_TYPE=default
MODEL_COMPUTE_TYPE_SMALL=default
MODEL_COMPUTE_TYPE_MEDIUM=default
MODEL_COMPUTE_TYPE_LARGE=default

# Hugging Face и вычислительное устройство
HF_TOKEN=
DEVICE=cuda

# Освобождение памяти моделей после простоя
RELEASE_MODELS_ON_IDLE=True

# Автоматическое удаление исходных файлов и результатов
AUTO_CLEANUP_ENABLED=True
CLEANUP_FILE_TTL_HOURS=48
CLEANUP_INTERVAL_MINUTES=360

# Ограничение длительности источника, скачиваемого через yt-dlp
YTDLP_MAX_DURATION_SEC=14400
